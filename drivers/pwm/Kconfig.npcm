config PWM_NPCM
	bool "Nuvoton NPCM Enhanced Super I/O (eSIO) PWM driver"
	default y
	depends on SOC_FAMILY_NPCM4XX && PWM
	help
	  This option enables the PWM driver for NPCM family of
	  processors.
	  Say y if you wish to use pwm ports on NPCM MCU.
