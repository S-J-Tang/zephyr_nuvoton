config C2H_NPCM
	bool "NPCM4XX core access to host modules driver"
	depends on SOC_FAMILY_NPCM4XX
	help
	  This option enables the c2h driver for NPCM
	  SoCs.
	  Say y if you wish to access host modules
	  on NPCM SMC.
